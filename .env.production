# Live domain. Drives canonical URLs, OpenGraph, JSON-LD and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://tradingnewsglobal.com

# Google AdSense publisher ID, e.g. ca-pub-1234567890123456
# Leave EMPTY until AdSense issues yours. When empty, no ad script loads and
# ad slots render as neutral placeholders — which is the correct state to be in
# while your site is under review.
NEXT_PUBLIC_ADSENSE_CLIENT=
