# ---------------------------------------------------------------------------
# Copy to .env.local for local development, or set these in your CI/host.
# ---------------------------------------------------------------------------

# Absolute site URL, no trailing slash.
# Used for canonical URLs, OpenGraph, JSON-LD and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://tradingnewsglobal.com

# Google AdSense publisher ID (format: ca-pub-XXXXXXXXXXXXXXXX).
# Found under AdSense -> Account -> Settings -> Account information.
# When set, the AdSense script loads and <AdSlot> renders real units.
# Must match the pub- ID in public/ads.txt.
NEXT_PUBLIC_ADSENSE_CLIENT=
