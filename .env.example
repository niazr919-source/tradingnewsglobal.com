# Absolute site URL — used for canonical URLs, OpenGraph, sitemap and JSON-LD.
# Set this in Vercel (Project Settings → Environment Variables) to your real domain.
NEXT_PUBLIC_SITE_URL=https://tradingnewsglobal.example.com

# Google AdSense publisher ID (format: ca-pub-XXXXXXXXXXXXXXXX).
# Leave blank until AdSense approves your site. When set, ad units go live and
# the AdSense script loads automatically. Also update public/ads.txt to match.
NEXT_PUBLIC_ADSENSE_CLIENT=
