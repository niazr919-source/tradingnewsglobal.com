# Live domain. Drives canonical URLs, OpenGraph, JSON-LD and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://tradingnewsglobal.com

# Google AdSense publisher ID. This value is public by design — it appears in
# ads.txt, in the page source and in the google-adsense-account meta tag — so it
# lives here rather than in a GitHub secret.
# Must match the pub- ID in public/ads.txt.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-2716080376550479
